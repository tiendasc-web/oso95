<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      <p class="hero__sub">{{ section.settings.text }}</p>
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="button button--ghost" href="{{ section.settings.button2_link | default: routes.collections_url }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      <ul class="hero__badges">
        <li>✔ Envío gratis</li>
        <li>✔ Pago contra entrega</li>
        <li>✔ Materiales suaves</li>
      </ul>
    </div>
    <div class="hero__media">
      <div class="hero__blob" aria-hidden="true"></div>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 990px) 45vw, 90vw', loading: 'eager', alt: section.settings.image.alt | default: section.settings.heading }}
      {%- elsif section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}" width="823" height="823" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portada (hero)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Nuevo · Colección Primeros Pasos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Sus primeros pasos, siempre protegidos" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Accesorios suaves y adorables que cuidan a tu bebé mientras explora el mundo." },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "url", "id": "image_url", "label": "URL de imagen (si no subes una)", "info": "Se usa solo si no eliges imagen arriba." },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace botón principal" },
    { "type": "text", "id": "button2_label", "label": "Botón secundario", "default": "Ver colecciones" },
    { "type": "url", "id": "button2_link", "label": "Enlace botón secundario" }
  ],
  "presets": [{ "name": "Portada (hero)" }]
}
{% endschema %}
