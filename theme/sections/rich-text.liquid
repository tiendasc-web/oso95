<section class="section{% if section.settings.soft %} section--soft{% endif %}">
  <div class="container container--narrow center">
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <p><a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Nuestra historia" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cuéntale a tus clientes sobre tu marca.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "soft", "label": "Fondo suave", "default": false }
  ],
  "presets": [{ "name": "Texto" }]
}
{% endschema %}
