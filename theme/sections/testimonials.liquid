{%- comment -%}
  Solo muestra testimonios reales. Los bloques vacíos o con el texto de ejemplo
  se ocultan en la tienda; si no queda ninguno, la sección entera desaparece.
  En el editor de temas se ven con un aviso para que sepas cuáles faltan.
{%- endcomment -%}
{%- liquid
  assign real_count = 0
  for block in section.blocks
    assign q = block.settings.quote | strip
    unless q == blank or q contains 'Reemplaza este texto' or q contains 'Escribe aquí la reseña'
      assign real_count = real_count | plus: 1
    endunless
  endfor
-%}
{%- if real_count > 0 or request.design_mode -%}
<section class="section">
  <div class="container">
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    {%- if real_count == 0 and request.design_mode -%}
      <p class="center muted">Esta sección está oculta en tu tienda hasta que agregues al menos un testimonio real.</p>
    {%- endif -%}
    <div class="testimonials">
      {%- for block in section.blocks -%}
        {%- assign q = block.settings.quote | strip -%}
        {%- assign is_placeholder = false -%}
        {%- if q == blank or q contains 'Reemplaza este texto' or q contains 'Escribe aquí la reseña' -%}
          {%- assign is_placeholder = true -%}
        {%- endif -%}
        {%- if is_placeholder == false or request.design_mode -%}
          {%- assign stars = block.settings.rating | default: 5 -%}
          <figure class="testimonial" {{ block.shopify_attributes }}>
            <p class="rating">
              <span class="rating__stars" aria-hidden="true">
                {%- for i in (1..5) -%}<span class="rating__star{% if i > stars %} rating__star--empty{% endif %}">{% render 'icon', name: 'star' %}</span>{%- endfor -%}
              </span>
              <span class="visually-hidden">{{ stars }} de 5 estrellas</span>
            </p>
            <blockquote>“{{ q }}”</blockquote>
            {%- if block.settings.author != blank -%}
              <figcaption>— {{ block.settings.author }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonios",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen las familias" },
    { "type": "paragraph", "content": "Usa solo reseñas reales de clientes. Los testimonios vacíos o con el texto de ejemplo no se muestran en la tienda." }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Testimonio", "default": "Escribe aquí la reseña real de un cliente." },
        { "type": "text", "id": "author", "label": "Autor", "info": "Nombre y ciudad, solo con permiso del cliente." },
        { "type": "range", "id": "rating", "label": "Estrellas que dio el cliente", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [{ "name": "Testimonios", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }]
}
{% endschema %}
