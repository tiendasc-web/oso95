<section class="section center">
  <div class="container container--narrow">
    <p class="logo-text"><span aria-hidden="true">🐝</span> {{ shop.name }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ shop.password_message }}</p>
    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prelanzamiento">
      {%- if form.posted_successfully? -%}
        <p class="form-success">¡Listo! Te avisaremos al abrir.</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="tu@correo.com" required aria-label="Correo">
        <button class="button" type="submit">Avísame</button>
      {%- endif -%}
    {%- endform -%}
    <details class="password-login">
      <summary>Entrar con contraseña</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <input type="password" name="password" placeholder="Contraseña" aria-label="Contraseña">
        <button class="button" type="submit">Entrar</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Contraseña",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¡Muy pronto abrimos!" }
  ]
}
{% endschema %}
