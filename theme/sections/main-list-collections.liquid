<section class="section">
  <div class="container">
    <header class="page-head"><h1>Colecciones</h1></header>
    <div class="grid">
      {%- for collection in collections -%}
        {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <article class="card">
          <a href="{{ collection.url }}" class="card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </a>
          <div class="card__body"><h2 class="card__title"><a href="{{ collection.url }}">{{ collection.title }}</a></h2><p>{{ collection.products_count }} productos</p></div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Lista de colecciones" }
{% endschema %}
