{%- comment -%}
  Renders a product price.
  Accepts: product (required)
{%- endcomment -%}
{%- liquid
  assign target = product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  <span class="price__current">{{ target.price | money }}</span>
  {%- if on_sale -%}
    <s class="price__compare">{{ target.compare_at_price | money }}</s>
    {%- assign saving = target.compare_at_price | minus: target.price | times: 100 | divided_by: target.compare_at_price -%}
    <span class="badge badge--sale">-{{ saving }}%</span>
  {%- endif -%}
</div>
