{%- comment -%}
  Accepts: product (required)
{%- endcomment -%}
<article class="card">
  <a href="{{ product.url }}" class="card__media" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.featured_media.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="badge badge--soldout">Agotado</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge badge--sale card__badge">Oferta</span>
    {%- endif -%}
  </a>
  <div class="card__body">
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}
  </div>
</article>
